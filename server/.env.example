# Database
DATABASE_URL="postgresql://user:password@localhost:5432/smile_db?sslmode=require"

# JWT Secrets
JWT_SECRET="your-jwt-secret-key"
JWT_REFRESH_SECRET="your-jwt-refresh-secret-key"
JWT_EXPIRES_IN="7d"
JWT_REFRESH_EXPIRES_IN="90d"

# Google OAuth - Use Web Client ID for verifying tokens from mobile app
GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-google-client-secret"

# Server
PORT=3000
NODE_ENV="development"

# File Upload
UPLOAD_DIR="./uploads"
MAX_FILE_SIZE=5242880

# Android App (for Google Sign-In)
PACKAGE_NAME="com.yourapp.name"
SHA1_FINGERPRINT="your-sha1-fingerprint"
