// Smile App Database Schema
// PostgreSQL with Prisma ORM

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// User model - synced with Google OAuth and profile updates
model User {
  id            String    @id @default(uuid())
  email         String    @unique
  username      String?   @unique
  displayName   String?
  profileImage  String?
  googleId      String    @unique
  currency      String    @default("INR")
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // Relations
  expenses        Expense[]        @relation("PaidBy")
  categories      Category[]
  friendships     Friendship[]     @relation("User")
  friendOf        Friendship[]     @relation("Friend")
  expenseSplits   ExpenseSplit[]
  notifications   Notification[]
  refreshTokens   RefreshToken[]

  @@index([email])
  @@index([username])
  @@index([googleId])
}

// Refresh token for JWT authentication
model RefreshToken {
  id        String   @id @default(uuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([token])
  @@index([userId])
}

// Category for expenses - includes default and user-created categories
model Category {
  id        String    @id @default(uuid())
  name      String
  icon      String?
  color     String?   // For chart colors
  isDefault Boolean   @default(false)
  userId    String?   // null for default categories
  user      User?     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime  @default(now())

  // Relations
  expenses  Expense[]

  @@unique([name, userId]) // User can't have duplicate category names
  @@index([userId])
  @@index([isDefault])
}

// Expense model - core expense tracking
model Expense {
  id          String         @id @default(uuid())
  amount      Decimal        @db.Decimal(12, 2)
  currency    String         @default("INR")
  description String
  notes       String?
  date        DateTime       @default(now()) // When expense occurred
  categoryId  String
  category    Category       @relation(fields: [categoryId], references: [id])
  paidById    String
  paidBy      User           @relation("PaidBy", fields: [paidById], references: [id], onDelete: Cascade)
  isDeleted   Boolean        @default(false) // Soft delete
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  // Relations
  splits      ExpenseSplit[]

  @@index([paidById])
  @@index([categoryId])
  @@index([date])
  @@index([createdAt])
}

// Expense split for bill splitting between friends
model ExpenseSplit {
  id                String    @id @default(uuid())
  expenseId         String
  expense           Expense   @relation(fields: [expenseId], references: [id], onDelete: Cascade)
  userId            String    // Who owes money
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  amount            Decimal   @db.Decimal(12, 2)
  isPaid            Boolean   @default(false)
  paidAt            DateTime?
  confirmedByPayer  Boolean   @default(false) // Person who paid original expense
  confirmedByPayee  Boolean   @default(false) // Person who owes money
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@unique([expenseId, userId]) // Each user can only have one split per expense
  @@index([userId])
  @@index([expenseId])
  @@index([isPaid])
}

// Friendship model - bidirectional friend relationships
model Friendship {
  id        String           @id @default(uuid())
  userId    String           // User who sent request
  user      User             @relation("User", fields: [userId], references: [id], onDelete: Cascade)
  friendId  String           // User who received request
  friend    User             @relation("Friend", fields: [friendId], references: [id], onDelete: Cascade)
  status    FriendshipStatus @default(PENDING)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  @@unique([userId, friendId])
  @@index([userId])
  @@index([friendId])
  @@index([status])
}

enum FriendshipStatus {
  PENDING
  ACCEPTED
  REJECTED
}

// Notification model - in-app notifications
model Notification {
  id        String           @id @default(uuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      NotificationType
  title     String
  message   String
  data      Json?            // Additional data for deep linking
  isRead    Boolean          @default(false)
  createdAt DateTime         @default(now())

  @@index([userId])
  @@index([isRead])
  @@index([createdAt])
}

enum NotificationType {
  BILL_SPLIT
  PAYMENT_REQUEST
  PAYMENT_CONFIRMED
  FRIEND_REQUEST
  FRIEND_ACCEPTED
}
